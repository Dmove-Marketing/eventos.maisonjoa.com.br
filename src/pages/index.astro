---
// Home one-page da Maison Joá. O HTML fica em src/home/index.html (imagens via CDN).
// A home anterior (hub com cards) está preservada em _index-hub.astro (prefixo "_" = não gera rota).
import html from '../home/index.html?raw';
import config from '../../config.json';
import WhatsAppWidget from '../components/ui/WhatsAppWidget.astro';
import { tipoEventoOptions } from '../scripts/lead-payload';

const gtmId = config.tracking?.gtm_id || '';
const gtm = config.tracking?.enabled !== false && gtmId;

const gtmHead = gtm
  ? `<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','${gtmId}');</script>`
  : '';
const gtmBody = gtm
  ? `<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=${gtmId}" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>`
  : '';

// Mesmos tipos de evento da página /bio; os corporativos abrem o campo "Empresa"
const corporativos = [
  'Confraternizacao corporativa', 'Corporativo', 'Feiras e Exposicoes', 'Masterclass e Palestras',
  'Mentorias e Treinamentos', 'Offsite corporativo', 'Reunioes de Networking', 'Workshops, Conferencias e Seminarios',
];
// "Bar e Bat Mitzvah" existe só nesta página (fica após "Aniversário debutante")
const opcoesHome = [...tipoEventoOptions];
opcoesHome.splice(opcoesHome.findIndex((o) => o.value === 'Aniversario debutante') + 1, 0, { value: 'Bar e Bat Mitzvah', label: 'Bar e Bat Mitzvah' });
const tipos = opcoesHome.map((o) => `<option value="${o.value}">${o.label}</option>`).join('');

const page = html
  .replace('<!--GTM_HEAD-->', gtmHead)
  .replace('<!--GTM_BODY-->', gtmBody)
  .replace('__TIPOS__', tipos)
  .replace('__CORPORATIVOS__', corporativos.join('|'))
  .replace('__WEBHOOK__', config.forms['lead-form'].webhooks[0]);

const head = page.match(/<head>([\s\S]*?)<\/head>/)![1];
const body = page.match(/<body[^>]*>([\s\S]*?)<\/body>/)![1];
---
<!doctype html>
<html lang="pt-BR">
<head><Fragment set:html={head} /></head>
<body>
  <Fragment set:html={body} />
  <WhatsAppWidget pageSource="Landing page/home" empresaCondicional={true} />
</body>
</html>
